{
  "expo": {
    "name": "Alcalá Cómics",
    "slug": "alcala-comics-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": { "resizeMode": "contain", "backgroundColor": "#1a0a2e" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alcalacomics.staff",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para escanear códigos de barras.",
        "NSMicrophoneUsageDescription": "Necesario para el uso de la cámara."
      }
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#1a0a2e" },
      "package": "com.alcalacomics.staff",
      "permissions": ["android.permission.CAMERA", "android.permission.VIBRATE"]
    },
    "plugins": ["expo-router", ["expo-camera", { "cameraPermission": "Necesitamos acceso a la cámara para escanear códigos de barras." }]],
    "scheme": "alcalacomics",
    "newArchEnabled": false,
    "extra": { "router": { "origin": false } }
  }
}
